{
  "name": "ocassio-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "typecheck": "tsc --noEmit",
    "verify": "bun scripts/verify-frontend.mjs",
    "verify:backend": "bun scripts/verify-backend.mjs",
    "verify:api": "bun scripts/verify-api.mjs",
    "verify:responsive": "bun scripts/verify-responsive.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/db-migrate.mjs",
    "db:seed": "bun scripts/seed-journal.mjs && bun scripts/seed-legal.mjs && bun scripts/seed-studio.mjs && bun scripts/seed-team.mjs && bun scripts/seed-services.mjs && bun scripts/seed-projects.mjs && bun scripts/seed-settings.mjs",
    "db:seed:admin": "bun scripts/seed-admin.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@libsql/client": "^0.18.0",
    "@node-rs/argon2": "^2.2.1",
    "@use-gesture/react": "^10.3.1",
    "@vercel/blob": "^2.8.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "gsap": "^3.15.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "next": "^15.5.26",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
